// Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                 String              @id @default(cuid())
  name               String
  slug               String?             @unique // architecture-v2.md §4: 反響メール宛先ルーティング用(hankyo+<slug>@...)
  phone              String?
  email              String?
  address            String?
  website            String?
  autoReplyEnabled   Boolean             @default(false)
  autoReplyMode      String              @default("DRAFT_ONLY") // "DRAFT_ONLY" | "AUTO_SEND" (Phase1=下書き承認/Phase2=自動送信、2026-08-26決定)
  autoReplySubject   String              @default("")
  autoReplyTemplate  String              @default("")
  storeName          String?
  storeAddress       String?
  storePhone         String?
  storeHours         String?
  storeAccess        String?
  storeWebsite       String?
  storeClosedDays    String?
  storeParking       String?
  logoUrl            String?
  lineUrl            String?
  licenseNumber      String?
  createdAt          DateTime            @default(now())
  users              User[]
  customers          Customer[]
  stores             Store[]
  statuses           Status[]
  templates          Template[]
  templateCategories TemplateCategory[]
  workflows          Workflow[]
  properties         Property[]
  schedules          Schedule[]
  storeVisitSettings StoreVisitSetting?
  storeVisitBookings StoreVisitBooking[]
  visitReminders     VisitReminder[]
  agentTemplates     AgentTemplate[]
  initialCostRules   InitialCostRule[]
  staffOrgAccesses   StaffOrgAccess[]
}

model User {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id])
  supabaseUserId    String?
  email             String           @unique
  name              String
  role              String           @default("MEMBER")
  avatarUrl         String?
  createdAt         DateTime         @default(now())
  isStaff           Boolean          @default(false) // true=ヘヤクレス社内オペレーター(複数クライアント横断アクセス可)
  assignedCustomers Customer[]       @relation("AssignedCustomers")
  messages          Message[]        @relation("SentMessages")
  auditLogs         AuditLog[]
  schedules         Schedule[]
  staffAccess       StaffOrgAccess[]
}

model StaffOrgAccess {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

model Store {
  id                String               @id @default(cuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  slug              String
  isDefault         Boolean              @default(false)
  phone             String?
  address           String?
  storeHours        String?
  storeAccess       String?
  storeParking      String?
  autoReplyEnabled  Boolean              @default(false)
  autoReplySubject  String               @default("")
  autoReplyTemplate String               @default("")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  closedDayRules    StoreClosedDayRule[]
  customers         Customer[]

  @@unique([organizationId, slug])
}

model StoreClosedDayRule {
  id              String    @id @default(cuid())
  storeId         String
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type            String // "WEEKLY" | "NTH_WEEKDAY" | "DATE_RANGE"
  weekday         Int? // 0=日〜6=土
  nth             Int? // 第◯(第2・第4なら2レコード)
  includeHolidays Boolean   @default(false)
  startDate       DateTime? @db.Date // 臨時休業(DATE_RANGE)
  endDate         DateTime? @db.Date
  note            String?
  createdAt       DateTime  @default(now())
}

// UserRole removed - using String

model Status {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  color          String          @default("#6b7280")
  description    String?
  order          Int
  isDefault      Boolean         @default(false)
  isSystem       Boolean         @default(false)
  customers      Customer[]
  historyFrom    StatusHistory[] @relation("StatusFrom")
  historyTo      StatusHistory[] @relation("StatusTo")
}

model Customer {
  id                     String              @id @default(cuid())
  organizationId         String
  organization           Organization        @relation(fields: [organizationId], references: [id])
  name                   String
  nameKana               String?
  email                  String?
  phone                  String?
  preferredContact       String?
  postalCode             String?
  address                String?
  gender                 String?
  age                    String?
  occupation             String?
  income                 String?
  currentArea            String?
  sourcePortal           String?
  inquiryContent         String?
  statusId               String
  status                 Status              @relation(fields: [statusId], references: [id])
  assigneeId             String?
  assignee               User?               @relation("AssignedCustomers", fields: [assigneeId], references: [id])
  storeId                String?
  store                  Store?              @relation(fields: [storeId], references: [id])
  isNeedAction           Boolean             @default(true)
  snoozedUntil           DateTime?
  hasCustomerReplied     Boolean             @default(false) // 顧客からの返信が一度でもあったか
  desireSignalDetectedAt DateTime? // 意欲シグナル(来店/内見の質問等)を検出した日時
  isBookingConfirmed     Boolean             @default(false) // アポ確定 vs 予約未確定を明示区別
  lineUserId             String?
  lineDisplayName        String?
  lineLinkedAt           DateTime?
  lineBlockedAt          DateTime?
  lineCode               String?
  autoFollowActive       Boolean             @default(true)
  memo                   String?
  lastActiveAt           DateTime?
  lastContactAt          DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  tags                   CustomerTag[]
  properties             InquiryProperty[]
  wishCondition          WishCondition?
  messages               Message[]
  schedules              Schedule[]
  storeVisitBookings     StoreVisitBooking[]
  workflowRuns           WorkflowRun[]
  records                CustomerRecord[]
  preference             CustomerPreference?
  statusHistory          StatusHistory[]
  auditLogs              AuditLog[]
}

model CustomerTag {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String

  @@unique([customerId, name])
}

model InquiryProperty {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name          String
  url           String?
  address       String?
  station       String?
  roomNumber    String?
  rent          String?
  area          String?
  layout        String?
  propertyId    String?
  inquiryId     String?
  vacancyStatus String? // "AVAILABLE" | "FULL" | "UNKNOWN" 等。満室時の代替提案トリガーに使う
  createdAt     DateTime @default(now())
}

model WishCondition {
  id          String   @id @default(cuid())
  customerId  String   @unique
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  areas       String?
  stations    String?
  rentMin     Int?
  rentMax     Int?
  layout      String?
  walkMinutes Int?
  buildAge    Int?
  areaMin     Float?
  features    String?
  moveInDate  String?
  reason      String?
  freeText    String?
  updatedAt   DateTime @updatedAt
}

model Message {
  id                String           @id @default(cuid())
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  senderId          String?
  sender            User?            @relation("SentMessages", fields: [senderId], references: [id])
  direction         Direction
  channel           Channel
  subject           String?
  body              String
  intentCategory    String? // VIEWING_REQUEST/VIEWING_RESCHEDULE/SIMILAR_PROPERTY_REQUEST/
  // CONDITION_CHANGE/PRICE_OR_FEE_INQUIRY/PROPERTY_QUESTION/DECLINE/BROUGHT_IN_URL_INQUIRY
  status            MessageStatus    @default(SENT)
  externalId        String?          @unique
  deliveredAt       DateTime?
  openedAt          DateTime?
  openCount         Int              @default(0)
  clickedAt         DateTime?
  clickCount        Int              @default(0)
  bouncedAt         DateTime?
  bounceReason      String?
  workflowStepRunId String?
  workflowStepRun   WorkflowStepRun? @relation(fields: [workflowStepRunId], references: [id])
  createdAt         DateTime         @default(now())
  events            MessageEvent[]
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum Channel {
  EMAIL
  LINE
  SMS
  CALL
  NOTE
  VISIT
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

model MessageEvent {
  id         String   @id @default(cuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type       String
  occurredAt DateTime
  metadata   Json?
  createdAt  DateTime @default(now())
}

model Schedule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  type           ScheduleType
  startAt        DateTime
  endAt          DateTime?
  isAllDay       Boolean      @default(false)
  location       String?
  color          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum ScheduleType {
  VISIT
  VIEWING
  CALL
  FOLLOW_UP
  OTHER
}

model TemplateCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  order          Int
  templates      Template[]
}

model Template {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  categoryId     String
  category       TemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  channel        Channel
  subject        String?
  body           String
  order          Int              @default(0)
  isActive       Boolean          @default(true)
  agentKey       String? // architecture-v2.md §8: AgentTemplate.keyと対応させ、テンプレート3重構造を統合する橋渡し
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  workflowSteps  WorkflowStep[]

  @@unique([organizationId, agentKey])
}

model Workflow {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  isDefault      Boolean        @default(false)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  steps          WorkflowStep[]
  runs           WorkflowRun[]
}

model WorkflowStep {
  id          String            @id @default(cuid())
  workflowId  String
  workflow    Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name        String
  daysAfter   Int
  timeOfDay   String
  channel     Channel
  templateId  String
  template    Template          @relation(fields: [templateId], references: [id])
  order       Int
  isImmediate Boolean           @default(false)
  isActive    Boolean           @default(true)
  stepRuns    WorkflowStepRun[]
}

model WorkflowRun {
  id               String            @id @default(cuid())
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workflowId       String
  workflow         Workflow          @relation(fields: [workflowId], references: [id])
  status           WFRunStatus       @default(RUNNING)
  startedAt        DateTime          @default(now())
  currentStepIndex Int               @default(0)
  nextRunAt        DateTime?
  stoppedAt        DateTime?
  stopReason       String?
  stepRuns         WorkflowStepRun[]
}

enum WFRunStatus {
  RUNNING
  COMPLETED
  STOPPED_BY_REPLY
  STOPPED_BY_LINE_ADD
  STOPPED_BY_VISIT
  STOPPED_BY_CALL
  STOPPED_MANUAL
}

model WorkflowStepRun {
  id            String        @id @default(cuid())
  workflowRunId String
  workflowRun   WorkflowRun   @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  stepId        String
  step          WorkflowStep  @relation(fields: [stepId], references: [id])
  status        StepRunStatus @default(PENDING)
  scheduledAt   DateTime
  executedAt    DateTime?
  errorMessage  String?
  retryCount    Int           @default(0)
  messages      Message[]
}

enum StepRunStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
  SKIPPED
}

model StatusHistory {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fromId     String?
  from       Status?  @relation("StatusFrom", fields: [fromId], references: [id])
  toId       String
  to         Status   @relation("StatusTo", fields: [toId], references: [id])
  changedBy  String?
  reason     String?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  action     String
  field      String?
  oldValue   String?
  newValue   String?
  createdAt  DateTime  @default(now())
}

model LinePending {
  id             String   @id @default(cuid())
  lineUserId     String   @unique
  displayName    String?
  pictureUrl     String?
  code           String
  organizationId String   @default("org_default")
  createdAt      DateTime @default(now())
}

model CustomerRecord {
  id         String    @id @default(uuid())
  customerId String
  type       String
  callResult String?
  title      String?
  body       String?
  visitDate  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([type])
}

model CustomerPreference {
  id                 String   @id @default(uuid())
  customerId         String   @unique
  area               String?
  station            String?
  walkMinutes        Int?
  rentMin            Int?
  rentMax            Int?
  layout             String?
  areaMin            Float?
  moveInDate         String?
  petOk              Boolean  @default(false)
  autoLock           Boolean  @default(false)
  bathToiletSeparate Boolean  @default(false)
  flooring           Boolean  @default(false)
  aircon             Boolean  @default(false)
  reheating          Boolean  @default(false)
  washletToilet      Boolean  @default(false)
  freeInternet       Boolean  @default(false)
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model StoreVisitSetting {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled            Boolean      @default(false)
  closedDays         String       @default("")
  availableTimeStart String       @default("09:30")
  availableTimeEnd   String       @default("17:00")
  visitMethods       String       @default("")
  storeNotice        String       @default("")
  autoReplySubject   String       @default("")
  autoReplyBody      String       @default("")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model StoreVisitBooking {
  id             String       @id @default(cuid())
  organizationId String
  customerId     String?
  name           String
  email          String
  phone          String       @default("")
  visitDate      DateTime     @db.Date
  visitTime      String
  visitMethod    String       @default("")
  memo           String       @default("")
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model VisitReminder {
  id               String       @id @default(cuid())
  channel          String       @default("EMAIL")
  timing           String       @default("1_day_before")
  timingHour       String       @default("10:00")
  subject          String?
  body             String       @default("")
  skipLineNotAdded Boolean      @default(false)
  organizationId   String
  order            Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Property {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  roomNumber     String?
  address        String?
  station        String?
  walkMinutes    Int?
  rent           Int
  managementFee  Int?         @default(0)
  deposit        String?
  keyMoney       String?
  layout         String?
  area           Float?
  age            Int?
  floor          String?
  features       String?
  availableFrom  DateTime?
  isAvailable    Boolean      @default(true)
  imageUrl       String?
  url            String?
  memo           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
}

model AgentTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String // e.g. "tpl_tent_a", "tpl_confirm", "tpl_fu1"
  title          String // Display name
  body           String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())

  @@unique([organizationId, key])
}

model InitialCostRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String // Rule name, e.g. "標準プラン", "初期費用軽減パック"
  isDefault      Boolean      @default(false)
  deposit        String? // 敷金ルール e.g. "賃料1ヶ月", "0"
  keyMoney       String? // 礼金ルール
  brokerageFee   String? // 仲介手数料 e.g. "賃料1ヶ月+税", "賃料0.5ヶ月+税"
  insuranceFee   String? // 火災保険 e.g. "20000", "15000"
  lockChangeFee  String? // 鍵交換費 e.g. "16500", "22000"
  guaranteeFee   String? // 保証料 e.g. "賃料50%", "月額賃料等合計の50%"
  cleaningFee    String? // クリーニング費
  otherFees      String? // その他費用（JSON or text）
  advanceRent    String? // 前家賃ルール e.g. "当月日割+翌月"
  notes          String?      @db.Text // 備考・特記事項
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
}
